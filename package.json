{
  "name": "dynalist-mcp",
  "version": "0.10.0",
  "description": "MCP server for Dynalist.io - read, write, search, and organize outliner content",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "inspector": "bunx @modelcontextprotocol/inspector bun src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint src/ scripts/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:worker": "vitest run",
    "check": "bun run typecheck && bun run lint && bun test && bun run test:worker && bun run generate-docs",
    "generate-docs": "bun scripts/generate-docs.ts",
    "bundle": "bash scripts/bundle.sh",
    "release": "bash scripts/release.sh",
    "worker-setup": "bun scripts/worker-setup.ts",
    "worker-config": "bun scripts/worker-setup.ts --config-only",
    "deploy": "wrangler deploy"
  },
  "keywords": ["mcp", "dynalist", "outliner", "model-context-protocol"],
  "author": "jayden-navarro",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.34.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261120.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^20.14.0",
    "eslint": "^10.0.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "wrangler": "4.166.0"
  }
}
